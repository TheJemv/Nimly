{
  "expo": {
    "name": "Nimly",
    "slug": "Nimly",
    "version": "1.3.8",
    "orientation": "portrait",
    "icon": "./assets/expo/icon.png",
    "scheme": "nimly",
    "backgroundColor": "#000000",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nimly.app",
      "appleTeamId": "B88RJAR9J7",
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "NSPhotoLibraryUsageDescription": "Nimly needs access to your photo library so you can share photos with your friends.",
        "NSCameraUsageDescription": "Nimly needs camera access so you can take photos and videos to share with your friends.",
        "NSMicrophoneUsageDescription": "Nimly needs microphone access so you can record videos to share with your friends.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/expo/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-notifications",
      "expo-camera",
      "expo-image-picker",
      "expo-video",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "nimly",
          "organization": "nimly"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "owner": "jemv05",
    "extra": {
      "eas": {
        "projectId": "a641f4fb-5891-4c81-9427-c57bb896c1b7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a641f4fb-5891-4c81-9427-c57bb896c1b7"
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
